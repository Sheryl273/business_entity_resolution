# Dataset — never commit, download locally per README
dataset/train/*.tsv
dataset/test/*.tsv

# Large generated artifacts
output/*.tsv
*.pkl
*.joblib
*.bin
*.model
feature_matrices/
*.parquet

# Trained model files and experiment reports (generated locally, not version-controlled)
models/
reports/
# LightGBM saves models as .txt — block them explicitly
matcher*.txt

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env

# OS/editor
.DS_Store
.vscode/
.idea/

# Keep folder structure without committing data
!dataset/train/.gitkeep
!dataset/test/.gitkeep
!output/.gitkeep

